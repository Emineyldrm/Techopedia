<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/techListFragment">

    <fragment
        android:id="@+id/techListFragment"
        android:name="com.emine.techopedia.view.TechListFragment"
        android:label="fragment_tech_list"
        tools:layout="@layout/fragment_tech_list" >
        <action
            android:id="@+id/action_techListFragment_to_techDetailFragment"
            app:destination="@id/techDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/techDetailFragment"
        android:name="com.emine.techopedia.view.TechDetailFragment"
        android:label="fragment_tech_detail"
        tools:layout="@layout/fragment_tech_detail" >
        <argument
            android:name="techId"
            app:argType="integer" />
    </fragment>
</navigation>